{
  "name": "ultimate-snake-game",
  "version": "1.0.0",
  "private": true,
  "description": "A standalone playable Snake game",
  "main": "electron/main.cjs",
  "scripts": {
    "build:offline": "node build-offline.mjs",
    "build:windows": "npm run build:offline && node scripts/prepare-app-game.mjs && electron-builder --win nsis",
    "build:android": "node scripts/build-android.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "com.kazeemahmad.ultimatesnake",
    "productName": "Ultimate Snake",
    "asar": true,
    "files": [
      "electron/main.cjs",
      "electron/game.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "UltimateSnake-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
